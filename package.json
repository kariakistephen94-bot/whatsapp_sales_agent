{
  "name": "whatsapp-ai-sales-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gateway": "node --env-file=gateway/.env gateway/src/server.js",
    "gateway:install": "npm install --prefix gateway",
    "worker": "tsx --tsconfig tsconfig.json src/workers/index.ts",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker\"",
    "wa:smoke": "tsx --tsconfig tsconfig.json scripts/wa-smoke.ts",
    "wa:inbound-test": "tsx --tsconfig tsconfig.json scripts/inbound-test.ts",
    "test:backend": "tsx --tsconfig tsconfig.json scripts/backend-test.ts",
    "test:unit": "tsx --tsconfig tsconfig.json scripts/unit-test.ts",
    "make-admin": "tsx --tsconfig tsconfig.json scripts/make-admin.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@whiskeysockets/baileys": "^6.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^18.0.10",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.460.0",
    "luxon": "^3.5.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.0",
    "openai": "^4.70.0",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

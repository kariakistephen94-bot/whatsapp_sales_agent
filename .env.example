# Supabase: Project Settings → API. The app needs nothing else from Supabase (no database URL).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only. Never expose the service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Public address of the app (no trailing slash). Used for payment return links.
APP_URL="http://localhost:3000"
# Domain for HTTPS when using docker compose (leave as localhost for local runs)
DOMAIN="localhost"

# AI (server-side only)
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o-mini"

# WhatsApp: encrypts saved WhatsApp sessions. Generate with: openssl rand -base64 32
WHATSAPP_SESSION_ENCRYPTION_KEY=""

# Billing: Paystack secret key (Settings → API Keys). Use sk_test_… while testing.
# Webhook URL to set in Paystack: {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""
